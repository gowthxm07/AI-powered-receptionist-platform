# Root Environment Variables Template

# PostgreSQL Container Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=receptionist_db
POSTGRES_PORT=5433

# Backend Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/receptionist_db?schema=public

# Backend Internal Service URL for Next.js Proxy
BACKEND_INTERNAL_URL=http://127.0.0.1:5000
