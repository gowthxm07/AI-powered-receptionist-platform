# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/receptionist_db?schema=public"

# Authentication Security
JWT_SECRET=replace_with_secure_random_secret
JWT_EXPIRES_IN=7d

# Local AI Runtime Configuration (Ollama - Free & Local)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_MS=60000
OLLAMA_KEEP_ALIVE=5m

# Local Speech Technology Configuration (Free & Local - Phase 6.2)
STT_ENABLED=true
STT_PROVIDER=whisper.cpp
STT_MODEL_NAME=tiny.en
STT_MODEL_PATH=./local-models/whisper/ggml-tiny.en.bin
STT_BINARY_PATH=./local-tools/whisper/Release/whisper-cli.exe
STT_THREADS=4
STT_TIMEOUT_MS=15000

TTS_ENABLED=true
TTS_PROVIDER=piper
TTS_MODEL_NAME=en_US-lessac-medium
TTS_MODEL_PATH=./local-models/piper/en_US-lessac-medium.onnx
TTS_CONFIG_PATH=./local-models/piper/en_US-lessac-medium.onnx.json
TTS_BINARY_PATH=./local-tools/piper/piper.exe
TTS_TIMEOUT_MS=15000

# Runtime Audio Storage Configuration
AUDIO_OUTPUT_DIR=./runtime/audio
AUDIO_UPLOAD_DIR=./runtime/uploads
AUDIO_TTL_MS=3600000
