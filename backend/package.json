{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API service for AI-Powered Smart Receptionist Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/test/index.ts",
    "benchmark:ollama": "tsx src/scripts/benchmark-ollama.ts",
    "benchmark:stt": "tsx src/scripts/benchmark-stt.ts",
    "benchmark:tts": "tsx src/scripts/benchmark-tts.ts",
    "benchmark:speech": "tsx src/scripts/benchmark-speech.ts",
    "benchmark:voice": "tsx src/scripts/benchmark-voice-latency.ts",
    "benchmark:voice-transport": "tsx src/scripts/benchmark-voice-transport.ts",
    "network:info": "tsx src/scripts/network-info.ts",
    "verify:proxy": "tsx src/scripts/verify-proxy.ts",
    "verify:audio-pipeline": "tsx src/scripts/verify-mobile-audio-pipeline.ts",
    "verify:mobile-voice": "tsx src/scripts/verify-mobile-voice.ts",
    "demo:voice": "tsx src/scripts/demo-voice-pipeline.ts",
    "demo:voice-conversation": "tsx src/scripts/demo-voice-conversation.ts",
    "demo:voice-transport": "tsx src/scripts/demo-voice-transport.ts",
    "ai:warmup": "tsx src/scripts/warmup-ollama.ts",
    "ai:smoke": "tsx src/scripts/smoke-test-ai.ts",
    "ai:orchestrate": "tsx src/scripts/demo-orchestrator.ts",
    "ai:booking-demo": "tsx src/scripts/demo-booking-flow.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset-demo": "tsx prisma/seed.ts --reset",
    "db:verify-demo": "tsx prisma/verify-seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.5",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5"
  }
}
