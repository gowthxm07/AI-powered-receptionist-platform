{
  "name": "frontend",
  "version": "1.0.0",
  "description": "Frontend web client for AI-Powered Smart Receptionist Platform",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "cert:generate": "node scripts/generate-certs.js",
    "dev:https": "node scripts/generate-certs.js && next dev -p 3000 -H 0.0.0.0 --experimental-https --experimental-https-key certificates/dev-key.pem --experimental-https-cert certificates/dev-cert.pem",
    "dev:mobile": "npm run dev:https",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.428.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.5",
    "postcss": "^8.4.38",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
